# RiskTwin — runtime host profile (Dell Pro Max with GB10 / DGX Spark)
#
# This is the only profile permitted to serve the demo. Copy to `.env` on the
# Dell after transferring the project:  cp .env.dgx .env
#
# Every base URL below must resolve to loopback or the Dell's own private
# address. `scripts/smoke_test_local_inference.py` fails the build otherwise.

RISKTWIN_CASE_ID=LIFT-042
RISKTWIN_HOST_PROFILE=runtime-host

# --- Storage -----------------------------------------------------------------
# Local single-node replica set; Change Streams require the replica set.
RISKTWIN_STORAGE_BACKEND=mongodb
RISKTWIN_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
RISKTWIN_MONGODB_DB=risktwin
RISKTWIN_STATE_DIR=data/state

# --- Text inference: shared agent model --------------------------------------
# Nemotron 3.5 Lightning 30B A3B NVFP4 served locally (vLLM / NIM, OpenAI-compatible).
# Fallback ladder, in order: Nemotron 3 Super 120B -> Llama 3.1 Nemotron 70B GGUF
# -> Nemotron 3 Nano 4B GGUF (degraded mode, labelled in the UI).
RISKTWIN_LLM_BACKEND=openai_compat
RISKTWIN_LLM_BASE_URL=http://127.0.0.1:8001/v1
RISKTWIN_LLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
RISKTWIN_LLM_TIMEOUT_SECONDS=90

# --- Vision: Vision Risk Agent -----------------------------------------------
# Nemotron Nano 12B v2 VL NVFP4-QAD on sampled frames (single-image inference).
# Fallbacks: Llama 3.1 Nemotron Nano VL 8B V1 -> Qwen2.5-VL-7B-Instruct
# -> `deterministic` local CV detector (narrow the claim if you land here).
RISKTWIN_VLM_BACKEND=openai_compat
RISKTWIN_VLM_BASE_URL=http://127.0.0.1:8002/v1
RISKTWIN_VLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-NVFP4-QAD
RISKTWIN_VLM_TIMEOUT_SECONDS=120

# --- Speech: Crew Comms Agent ------------------------------------------------
# Parakeet Unified English 0.6B served locally. Fallback: parakeet-tdt-0.6b-v3.
RISKTWIN_ASR_BACKEND=openai_compat
RISKTWIN_ASR_BASE_URL=http://127.0.0.1:8003/v1
RISKTWIN_ASR_MODEL=nvidia/parakeet-unified-en-0.6b
RISKTWIN_ASR_TIMEOUT_SECONDS=120

# --- Framework integration ---------------------------------------------------
# `native` delegates policy decisions to the installed NVIDIA OpenShell runtime.
RISKTWIN_OPENSHELL_BACKEND=native
RISKTWIN_AGENT_RUNTIME=openclaw
RISKTWIN_LIFECYCLE=nemoclaw

# --- Safety rails ------------------------------------------------------------
RISKTWIN_ALLOW_REMOTE_INFERENCE=false
# Leave false unless an organizer explicitly approves the allowlisted connector.
RISKTWIN_DATA_WATCHER_LIVE_FETCH=false

# --- Replay ------------------------------------------------------------------
RISKTWIN_REPLAY_SPEED=1.0

# --- Service binding ---------------------------------------------------------
RISKTWIN_API_HOST=0.0.0.0
RISKTWIN_API_PORT=8000
