# RiskTwin — build-console profile (Apple Silicon MacBook)
#
# This profile runs the full application, agent loop, replay engine, risk engine,
# dashboard and worker PWA with NO model downloads and NO MongoDB install.
# Every inference adapter runs in `deterministic` mode and the dashboard labels
# it as such. Copy to `.env` to activate:  cp .env.mac .env

RISKTWIN_CASE_ID=LIFT-042
RISKTWIN_HOST_PROFILE=build-console

# --- Storage -----------------------------------------------------------------
# `file` = append-only local journal with a local change feed (no MongoDB needed).
RISKTWIN_STORAGE_BACKEND=file
RISKTWIN_STATE_DIR=data/state

# --- Inference ---------------------------------------------------------------
# `deterministic` adapters are real local code, never a hosted API.
RISKTWIN_LLM_BACKEND=deterministic
RISKTWIN_VLM_BACKEND=deterministic
RISKTWIN_ASR_BACKEND=deterministic

# --- Framework integration ---------------------------------------------------
RISKTWIN_OPENSHELL_BACKEND=shim
RISKTWIN_AGENT_RUNTIME=inprocess
RISKTWIN_LIFECYCLE=local

# --- Safety rails ------------------------------------------------------------
RISKTWIN_ALLOW_REMOTE_INFERENCE=false
RISKTWIN_DATA_WATCHER_LIVE_FETCH=false

# --- Replay ------------------------------------------------------------------
RISKTWIN_REPLAY_SPEED=1.0

# --- Service binding ---------------------------------------------------------
RISKTWIN_API_HOST=0.0.0.0
RISKTWIN_API_PORT=8000
